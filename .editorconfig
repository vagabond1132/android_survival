# EditorConfig: https://editorconfig.org
# 荒野手册 - 跨平台 (Windows/Linux/macOS) 统一编码规范
# IDE/编辑器自动读取本文件, 保证不同环境下文件编码一致

root = true

# ============ 全局默认 ============
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ============ C++ / Qt ============
[*.{cpp,h,hpp,c,cc}]
charset = utf-8
indent_size = 4
max_line_length = 120

# ============ QML / JS ============
[*.{qml,js}]
charset = utf-8
indent_size = 4

# ============ Java ============
[*.java]
charset = utf-8
indent_size = 4
max_line_length = 120

# ============ Gradle (Groovy DSL) ============
[*.{gradle,gradle.kts}]
charset = utf-8
indent_size = 4

# ============ XML (AndroidManifest, layouts, etc.) ============
[*.xml]
charset = utf-8
indent_size = 4

# ============ JSON ============
[*.json]
charset = utf-8
indent_size = 2

# ============ YAML ============
[*.{yml,yaml}]
charset = utf-8
indent_size = 2

# ============ CMake ============
[CMakeLists.txt]
charset = utf-8
indent_size = 4

[*.{cmake,cmake.in}]
charset = utf-8
indent_size = 4

# ============ Shell ============
[*.{sh,bash}]
charset = utf-8
indent_size = 4

# ============ Windows 批处理 (强制 CRLF, Windows 原生) ============
[*.{bat,cmd,ps1}]
end_of_line = crlf
charset = utf-8
indent_size = 4

# ============ Markdown ============
[*.md]
charset = utf-8
indent_size = 2
trim_trailing_whitespace = false  # Markdown 末尾两空格表示换行, 不裁剪

# ============ Properties ============
[*.{properties,props}]
charset = utf-8
indent_size = 2

# ============ Makefile (强制 TAB) ============
[Makefile]
indent_style = tab

# ============ INI ============
[*.{ini,conf}]
charset = utf-8
indent_size = 4
